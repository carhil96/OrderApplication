{
  "realm": "orders",
  "enabled": true,
  "accessCodeLifespan": 300,
  "displayName": "Orders local development",
  "roles": {
    "realm": [
      { "name": "ORDER_READ", "description": "Read orders" },
      { "name": "ORDER_WRITE", "description": "Create orders" }
    ]
  },
  "clients": [
    {
      "clientId": "orders-cli",
      "name": "Orders local client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost/*"],
      "webOrigins": ["http://localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"]
    }
  ],
  "users": [
    {
      "username": "reader",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "reader-dev-only", "temporary": false }
      ],
      "realmRoles": ["ORDER_READ"]
    },
    {
      "username": "writer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "writer-dev-only", "temporary": false }
      ],
      "realmRoles": ["ORDER_WRITE"]
    }
  ]
}
